@model ICart

<div class="row">
 
    @if (Model.TryGetAll().Count != 0)
    { 
        <div class="col-8 card shadow">
            <div class="card-body">                  
            @foreach (var position in Model.TryGetAll())
            {     
                <li class="list-group-item">       
                    <div class="container">
                        <div class="row row-cols-12">
                            <div class="col-5">
                                <a style="color:#393D4A" href="/product/index/@position.Product.ID"><h5>@position.Product.Name</h5></a>                            
                                <img src="~/images/@position.Product.Src"
                                    class="img-fluid rounded-circle mb-2"
                                    style="width: 80px; height: 80px" />
                            </div>
                            <div class="col-5 text-center">
                                <h5 style="color:#393D4A"> Count: @position.Count</h5>
                                <a class="btn btn-light" role="button" href="/cart/add?productId=@position.Product.ID">+</a>
                                <a class="btn btn-light" role="button" href="/cart/reducecount?productId=@position.Product.ID">-</a>
                                <h5 style="color:#393D4A">Price: @position.PositionPrice</h5>                                        
                            </div>
                            <div class="col-2 text-right">
                                <h5>ㅤㅤㅤ</h5>
                                <a class="btn btn-dark" role="button" href="/cart/remove?productId=@position.Product.ID">Remove</a>
                            </div>
                        </div>
                    </div>  
                </li>
            }
            </div>
        </div>
    
    <div class="col-4 card shadow">
        <div class="card-body d-flex flex-column">
            <h5 style="color:#393D4A">Sum: @Model.FullCartPrice</h5>
            <a class="btn btn-dark mt-auto" role="button" href="/order/index">Make an order</a>
            <br />
            <a role="button" class = "text-center" href="/authentication/register">Register</a>
        </div>
    </div>

    }

    else {
    <div class="col-12 card shadow">
        <div class="card-body">
            <h5 style="color:#393D4A">Cart is empty!</h5>
        </div>
    </div>
    }

</div>

<div class="text-center"></div>