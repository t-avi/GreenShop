@model List<IProduct>

<div class="text-center">Searching results:</div>

<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-4 card shadow text-center">
            <div class="card-body">
                <img  
                    src="~/images/@product.Src"
                    class="img-fluid rounded-circle mb-2"
                    style="width: 80px; height: 80px" />
                <a style="color:#393D4A" href="/product/index/@product.ID"><h5>@product.Name</h5></a>
                <h5 style="color:#393D4A">@product.Cost $</h5>
                <a class="btn btn-dark" role="button" href="/cart/add?productId=@product.ID">Add to cart</a>
                <a class="btn btn-dark" role="button" href="/compare/add?productId=@product.ID">Add to compare</a>
                <a class="btn btn-dark" role="button" href="/favourites/add?productId=@product.ID">Add to fav</a>
            </div>
        </div>
    }
</div>