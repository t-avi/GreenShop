@model IFavourites

<div class="row">

    @if (Model.TryGetAll().Count != 0)
    {
        <div class="col-8 card shadow text-center">
            <div class="card-body">
                @foreach (var position in Model.TryGetAll())
                {
                    <div class="container">
                        <div class="row row-cols-12">
                            <div class="col-5">
                                <a style="color:#393D4A" href="/product/index/@position.Product.ID"><h5>@position.Product.Name</h5></a>
                                <img src="~/images/@position.Product.Src"
                                     class="img-fluid"
                                     style="width: 320px; height: 320px" />
                            </div>
                            <div class="col-5">
                                <h5> ⠀</h5>
                                <h5 style="color:#393D4A">Price: @position.PositionPrice</h5>
                            </div>
                            <div class="col-2">
                                <h5> ⠀</h5>
                                <a class="btn btn-dark" role="button" href="/favourites/remove?productId=@position.Product.ID">Remove</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    else
    {
        <div class="col-12 card shadow">
            <div class="card-body">
                <h5 style="color:#393D4A">Fav is empty!</h5>
            </div>
        </div>
    }

</div>

<div class="text-center"></div>