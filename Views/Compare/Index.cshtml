@model ICompare

<div class="row">
    
    @if (Model.GetComparedProducts().Count() > 0)
    { 
        
        @foreach (var position in Model.GetComparedProducts())
        {
            <div class="col-2 card shadow text-center">
                <div class="card-body d-flex flex-column">
                    <div class="container">
                        <div class="row row-cols-12">
                            <div class="col-12 rounded-circle mb-2">
                                <a style="color:#393D4A" href="/product/index/@position.ID"><h5>@position.Name</h5></a>                                
                                <img src="~/images/@position.Src"
                                     class="img-fluid rounded-circle mb-2"
                                     style="width: 80px; height: 80px" />
                                <a style="color:#393D4A" ><h5>@position.Cost $</h5></a>
                                <a style="color:#393D4A"><h5>@position.Description</h5></a>
                                <br />                                
                            </div>                        
                        </div>
                    </div>                    
                </div>
                <a class="btn btn-primary btn-dark" role="button" href="/compare/remove?productId=@position.ID">Remove</a>
                <br/>
            </div>
        }            
    }
    else
    {
        <div class="col-12 card shadow">
            <div class="card-body">
                <h5 style="color:#393D4A">Nothing was compared yet!</h5>
            </div>
        </div>
    }
</div>