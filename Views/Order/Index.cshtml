@model ICart

<div class="row">
    @if (Model.TryGetAll().Count != 0)
    { 
    <div class="col-8 card shadow text-center">
        <div class="card-body">
            @foreach (var position in Model.TryGetAll())
            {        
                <div class="container">
                    <div class="row row-cols-12">
                        <div class="col-5">
                            <a style="color:#393D4A" href="/product/index/@position.Product.ID"><h5>@position.Product.Name</h5></a>                            
                            <img src="~/images/@position.Product.Src"
                                class="img-fluid"
                                style="width: 320px; height: 320px" />

                        </div>
                        <div class="col-5">
                            <h5> ⠀</h5>
                            <h5 style="color:#393D4A">Count: @position.Count</h5>
                            <h5 style="color:#393D4A">Price: @position.PositionPrice</h5>
                        </div>                        
                    </div>
                </div>         
            }
        </div>
    </div>

    
    <div class="col-4 card shadow">
        <div class="card-body">        
            <form method="post">
                <label>Email Adress</label>
                <div> 
                    <input type="text" name="email"/>
                </div>

                <label>Name</label>
                <div>
                    <input type="text" name="name" />
                </div>

                <label>Phone number</label>
                <div>
                    <input type="text" name="phone" />
                </div>

                <label>Address</label>
                <div>
                    <input type="text" name="address" />
                </div>            

                <h5 style="color:#393D4A">Sum: @Model.FullCartPrice</h5>
                <button class="btn btn-dark" type="submit" asp-controller="Order" asp-action="Make">Pay</button>
            </form>
        </div>
        </div>
    }
    else
    {
    <div class="col-12 card shadow">
        <div class="card-body">
            <h5 style="color:#393D4A">No orders yet!</h5>
        </div>
    </div>
    }

</div>
