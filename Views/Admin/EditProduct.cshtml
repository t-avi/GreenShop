@model IProduct

<div class="row">
    <div class="col-4 card shadow">
        <div class="card-body">

            <a style="color:#393D4A"><h5>@Model.Name</h5></a>
            <h5 style="color:#393D4A">@Model.Cost $</h5>
            <h5 style="color:#393D4A">@Model.Description</h5>
        </div>
    </div>
</div>

<div class="col-4 card shadow">
    <div class="card-body">
        <form method="post">
            <label>Name</label>
            <div>
                <input type="text" name="name" value=@Model.Name />
            </div>

            <label>Description</label>
            <div>
                <input type="text" name="description" value=@Model.Description />
            </div>

            <label>Cost</label>
            <div>
                <input type="text" name="cost" value=@Model.Cost />
            </div>
            <br />
            <label>Product ID</label>
            <div>
                <input type="text" name="id" readonly class="form-control-plaintext" value=@Model.ID />
            </div>
            <br />
            <button class="btn btn-dark" type="ssubmit" asp-controller="admin" asp-action="editselectedproduct">Edit</button>
        </form>
    </div>
</div>