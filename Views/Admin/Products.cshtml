@model IProductRepository 

<div class="row">
    <div class="col-6 card shadow">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Cost</th>
                    <th scope="col">Desc</th>
                    <th scope="col"></th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
    @foreach (var product in Model.GetAll())
    {
        <tr>
            <th scope="row">1</th>
            <td>@product.Name</td>
            <td>@product.Cost $</td>
            <td>@product.Description</td>
            <td>
                <a role="button" href="/admin/editproduct/@product.ID">Edit</a>
            </td>
            <td>
                <a role="button" href="/admin/removeproduct/@product.ID">Delete</a>
            </td>
        </tr>              
    }
    </tbody>
    </table>
    </div> 

    <div class="col-6">
        <a class="btn btn-dark" role="button" href="/admin/newproduct">Add new product</a>
    </div>
</div>
